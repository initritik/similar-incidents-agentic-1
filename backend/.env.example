APP_ENV=production

# OpenAI Configuration (Required)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...your-api-key-here...

# Qdrant Cloud Configuration (Required)
# Get from: https://cloud.qdrant.io
QDRANT_URL=https://...eu-west-2...qdrant.io
QDRANT_API_KEY=eyJ...your-api-key-here...

# Optional Configuration
QDRANT_COLLECTION_NAME=incident_resolution_collection
INGESTION_BATCH_SIZE=10
LOG_LEVEL=INFO

# Frontend Base URL (update to your Vercel frontend URL)
FRONTEND_URL=https://your-frontend-on-vercel.vercel.app

